            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">Completedresponse = ctx.getPreviousResult().getResponseCode();

status = vars.get(&quot;status&quot;);
log.info(&quot;Subnet Status: &quot; + status);
System.out.println(&quot;Subnet Status: &quot; + status);
state = vars.get(&quot;state&quot;);
log.info(&quot;Subnet State: &quot; + state);
System.out.println(&quot;Subnet State: &quot; + state);

try_count = Integer.parseInt(vars.get(&quot;try_count&quot;));
try_limit = props.get(&quot;try_limit&quot;);

//{&quot;State&quot;:&quot;Program&quot;,&quot;Status&quot;:&quot;Completed&quot;,&quot;FailureDetail&quot;:{&quot;ErrorCode&quot;:0,&quot;Text&quot;:&quot;&quot;,&quot;HttpStatusCode&quot;:0}}

//(status.equals(&quot;Completed&quot;))
//(response.equals(&quot;200&quot;))

if (status.equals(&quot;Completed&quot;)){
	vars.put(&quot;was_created&quot;,&quot;Created&quot;);
	vars.put(&quot;created&quot;,&quot;TRUE&quot;);
}

if (((try_count &gt; 10) &amp;&amp; (state.equals(&quot;bad_state&quot;))) || (try_count &gt; try_limit)) {
	vars.put(&quot;was_created&quot;,&quot;NOT Created&quot;);
	vars.put(&quot;created&quot;,&quot;TRUE&quot;);
}


log.info(&quot;trial:&quot;);
log.info(String.valueOf(try_count));
System.out.println(&quot;trial: &quot; + String.valueOf(try_count));
vars.put(&quot;try_count&quot;, String.valueOf(try_count + 1));
Thread.sleep(1000);</stringProp>
