            <stringProp name="script">response = ctx.getPreviousResult().getResponseCode();

try_count = Integer.parseInt(vars.get(&quot;try_count&quot;));
try_limit = props.get(&quot;try_limit&quot;);

if (try_count &gt; try_limit) {
log.info(&quot;TRY LIMIT EXCEEDED: continuing&quot;);
}

if ((try_count &gt; try_limit) || (response.equals(&quot;200&quot;))){
vars.put(&quot;created&quot;,&quot;TRUE&quot;);
}

log.info(&quot;trial:&quot;);
log.info(String.valueOf(try_count));

vars.put(&quot;try_count&quot;, String.valueOf(try_count + 1));</stringProp>
