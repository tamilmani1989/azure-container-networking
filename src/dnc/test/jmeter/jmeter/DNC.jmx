      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Analyze CSV Files" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import org.apache.commons.io.FileUtils;
import org.apache.jmeter.services.FileServer;


vars.put(&quot;was_created&quot;,&quot;NOT Created&quot;);

// Determines whether local testing or pipeline testing and sets variables accordingly

local_dir = &quot;C:\\Users\\t-cobish\\Desktop\\Networking-Aquarius\\src\\dnc\\test\\jmeter\\jmeter&quot;;
base_dir = FileServer.getFileServer().getBaseDir();
selected_path = base_dir;
props.put(&quot;base_dir&quot;, selected_path);

local = false
if (local_dir.equals(base_dir)) {
	local = true
} 

net_count_path = selected_path + &quot;/net_count.txt&quot;;
subnets_per_net_count_path = selected_path + &quot;/subnets_per_net_count.txt&quot;;
containers_per_node_count_path = selected_path + &quot;/containers_per_node_count.txt&quot;;
containers_per_subnet_count_path = selected_path + &quot;/containers_per_subnet_count.txt&quot;;
try_limit_path = selected_path + &quot;/try_limit.txt&quot;;
requests_per_second_path = selected_path + &quot;/requests_per_second.txt&quot;;

String net_count = FileUtils.readLines(new File(net_count_path)).get(0);
String subnets_per_net_count = FileUtils.readLines(new File(subnets_per_net_count_path)).get(0);
String containers_per_node_count = FileUtils.readLines(new File(containers_per_node_count_path)).get(0);
String containers_per_subnet_count = FileUtils.readLines(new File(containers_per_subnet_count_path)).get(0);
int try_limit = Integer.parseInt(FileUtils.readLines(new File(try_limit_path)).get(0));
int requests_per_second = Integer.parseInt(FileUtils.readLines(new File(requests_per_second_path)).get(0));

// Generates Test Plan Data 3 2 8 2
if (local) {
	cmd_string = &quot;python &quot; + selected_path + &quot;/generate_python.py &quot; + net_count + &quot; &quot; + subnets_per_net_count + &quot; &quot; + containers_per_subnet_count  + &quot; &quot;  + containers_per_node_count;
	System.out.println(cmd_string);
	log.info(cmd_string);
	Process process = Runtime.getRuntime().exec(cmd_string);
	Thread.sleep(5000);
} else {
	command_permission = &quot;chmod +x &quot; + selected_path + &quot;/create_data.sh&quot;;   
	Process process_permissiom = Runtime.getRuntime().exec(command_permission);
	Thread.sleep(5000);
	cmd_string = &quot;bash &quot; + selected_path + &quot;/create_data.sh &quot; + net_count + &quot; &quot; + subnets_per_net_count + &quot; &quot; + containers_per_subnet_count  + &quot; &quot;  + containers_per_node_count;
	System.out.println(cmd_string);
	Process process = Runtime.getRuntime().exec(cmd_string);
	Thread.sleep(30000);
}

// Creates Paths to Generates Test Plan Data
net_path = selected_path + &quot;/nets.csv&quot;;
subnet_path = selected_path + &quot;/subnets.csv&quot;;
node_path = selected_path + &quot;/nodes.csv&quot;;
container_path = selected_path + &quot;/containers.csv&quot;;
ip_path = selected_path + &quot;/ip.txt&quot;;

props.put(&quot;net_path&quot;, net_path);
props.put(&quot;subnet_path&quot;, subnet_path);
props.put(&quot;node_path&quot;, node_path);
props.put(&quot;container_path&quot;, container_path);


// SET RATES
max_http_time = &quot;80&quot;;

// PROCESS DATA

String ip_address = FileUtils.readLines(new File(ip_path)).get(0);
props.put(&quot;public_ip&quot;, ip_address);

props.put(&quot;max_http_time&quot;, max_http_time);

int nets = FileUtils.readLines(new File(net_path)).size(); // get lines count
props.put(&quot;nets&quot;, String.valueOf(nets)); // store the count into &quot;lines&quot; variable
time = (int)Math.ceil(nets/requests_per_second);
props.put(&quot;net_time&quot;, String.valueOf(time));

int subnets = FileUtils.readLines(new File(subnet_path)).size(); // get lines count
props.put(&quot;subnets&quot;, String.valueOf(subnets)); // store the count into &quot;lines&quot; variable
time = (int)Math.ceil(subnets/requests_per_second);
props.put(&quot;subnet_time&quot;, String.valueOf(time));

int nodes = FileUtils.readLines(new File(node_path)).size(); // get lines count
props.put(&quot;nodes&quot;, String.valueOf(nodes)); // store the count into &quot;lines&quot; variable
time = (int)Math.ceil(nodes/requests_per_second);
props.put(&quot;node_time&quot;, String.valueOf(time));


int containers = FileUtils.readLines(new File(container_path)).size(); // get lines count
props.put(&quot;containers&quot;, String.valueOf(containers)); // store the count into &quot;lines&quot; variable
time = (int)Math.ceil(containers/requests_per_second);
props.put(&quot;container_time&quot;, String.valueOf(time));

props.put(&quot;try_limit&quot;, try_limit);


// Log Data (for Debugging Purposes)

System.out.println(ip_address);
log.info(ip_address);

net_array =  FileUtils.readLines(new File(net_path));

for (String net : net_array) {
	System.out.println(net);
	log.info(net);
}

node_array =  FileUtils.readLines(new File(node_path));

for (String node : node_array) {
	System.out.println(node);
	log.info(node);
}

container_array =  FileUtils.readLines(new File(container_path));


for (String container : container_array) {
	System.out.println(container);
	log.info(container);
}




















