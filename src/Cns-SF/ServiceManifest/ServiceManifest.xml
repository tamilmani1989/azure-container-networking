<?xml version="1.0" encoding="UTF-8"?>
<ServiceManifest Name="CnsWrapperService" Version="2020.3.13.1" xsi:schemaLocation="http://schemas.microsoft.com/2011/01/fabric WinFabServiceModel.xsd" xmlns="http://schemas.microsoft.com/2011/01/fabric" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Description>Cns Wrapper Service</Description>
  <ServiceTypes>
    <StatelessServiceType ServiceTypeName="CnsWrapperServiceType">
    </StatelessServiceType>
  </ServiceTypes>
  <CodePackage Name="Code" Version="2020.3.13.1">
    <EntryPoint>
      <ExeHost>
        <Program>CnsWrapperService.exe</Program>
        <WorkingFolder>CodeBase</WorkingFolder>
        <ConsoleRedirection FileRetentionCount="5" FileMaxSizeInKb="2048"/>
      </ExeHost>
    </EntryPoint>
  </CodePackage>

  <ConfigPackage Name="Config" Version="2020.3.13.1" />

  <Resources>
    <Endpoints>
      <Endpoint Protocol="http" Name="AzureCnsEndpoint" Type="Input" />
      <Endpoint Protocol="http" Name="AzureCnsEndpointOverride" Type="Input" />
    </Endpoints>
  </Resources>
</ServiceManifest>
