<?xml version="1.0" encoding="utf-8"?>
<Settings xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.microsoft.com/2011/01/fabric">
  <Section Name="Config">
    <Parameter Name="WrapperShutdownThreadWaitTimeout" Value="00:00:01" />
    <Parameter Name="WrapperMainThreadShutdownCheck" Value="00:00:01" />
    <Parameter Name="WrapperMainLoopTimeout" Value="00:00:01" />
    <Parameter Name="WrapperThreadWaitTimeout" Value="00:00:01" />
    <Parameter Name="EnablePortOverride" Value="false" /> <!-- true for dev environment -->
    <Parameter Name="StartCnm" Value="false" />
    <Parameter Name="SetupHnsAtStartup" Value="true" />
    <Parameter Name="DefaultExtNetworkType" Value="l2bridge" />
    <Parameter Name="EnableTelemetry" Value="true" />
    <Parameter Name="HttpConnectionTimeoutInSeconds" Value="5" />
    <Parameter Name="HttpResponseHeaderTimeoutInSeconds" Value="120" />
    <Parameter Name="StoreFilePath" Value="" />
      <!-- keep in sync with config file https://github.com/Azure/azure-container-networking/blob/master/cns/configuration/cns_config.json -->
    <Parameter Name="DisableAll" Value="false"/>
    <Parameter Name="DisableTrace" Value="false"/>
    <Parameter Name="DisableMetric" Value="false"/>
    <Parameter Name="DisableEvent" Value="false"/>
    <Parameter Name="TelemetryBatchSizeBytes" Value="32768"/>
    <Parameter Name="TelemetryBatchIntervalInSecs" Value="30"/>
    <Parameter Name="HeartBeatIntervalInMins" Value="30"/>
    <Parameter Name="DisableMetadataRefreshThread" Value="false"/>
    <Parameter Name="RefreshIntervalInSecs" Value="15"/>
    <Parameter Name="DebugMode" Value="false"/>
    <Parameter Name="SnapshotIntervalInMins" Value="60"/>
  </Section>
</Settings>