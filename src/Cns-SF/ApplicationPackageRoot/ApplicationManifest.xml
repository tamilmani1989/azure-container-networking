<?xml version="1.0" encoding="UTF-8"?>
<ApplicationManifest ApplicationTypeName="CnsWrapperServiceApplicationType" ApplicationTypeVersion="2021.1.22.1" xsi:schemaLocation="http://schemas.microsoft.com/2011/01/fabric/WinFabServiceModel.xsd" xmlns="http://schemas.microsoft.com/2011/01/fabric" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Description>Cns Wrapper Application</Description>
    <Parameters>
      <Parameter Name="Cns_InstanceCount" DefaultValue="-1" />
      <Parameter Name="Cns_Port" DefaultValue="10090" />
      <Parameter Name="Cns_Setting_WrapperShutdownThreadWaitTimeout" DefaultValue="00:00:01" />
      <Parameter Name="Cns_Setting_WrapperMainThreadShutdownCheck" DefaultValue="00:00:01" />
      <Parameter Name="Cns_Setting_WrapperMainLoopTimeout" DefaultValue="00:00:01" />
      <Parameter Name="Cns_Setting_WrapperThreadWaitTimeout" DefaultValue="00:00:01" />
      <Parameter Name="Cns_Setting_EnablePortOverride" DefaultValue="false" />
      <Parameter Name="Cns_Setting_StartCnm" DefaultValue="false" />
      <Parameter Name="Cns_Setting_SetupHnsAtStartup" DefaultValue="true" />
      <Parameter Name="Cns_Setting_DefaultExtNetworkType" DefaultValue="l2bridge" />
      <Parameter Name="Cns_Setting_EnableTelemetry" DefaultValue="true" />
      <Parameter Name="Cns_Setting_HttpConnectionTimeoutInSeconds" DefaultValue="5" />
      <Parameter Name="Cns_Setting_HttpResponseHeaderTimeoutInSeconds" DefaultValue="120" />
      <Parameter Name="Cns_Setting_StoreFilePath" DefaultValue="" />
        <!-- keep in sync with config file https://github.com/Azure/azure-container-networking/blob/master/cns/configuration/cns_config.json -->
      <Parameter Name="Cns_Setting_DisableAll" DefaultValue="false"/>
      <Parameter Name="Cns_Setting_DisableTrace" DefaultValue="false"/>
      <Parameter Name="Cns_Setting_DisableMetric" DefaultValue="false"/>
      <Parameter Name="Cns_Setting_DisableEvent" DefaultValue="false"/>
      <Parameter Name="Cns_Setting_TelemetryBatchSizeBytes" DefaultValue="32768"/>
      <Parameter Name="Cns_Setting_TelemetryBatchIntervalInSecs" DefaultValue="30"/>
      <Parameter Name="Cns_Setting_HeartBeatIntervalInMins" DefaultValue="30"/>
      <Parameter Name="Cns_Setting_DisableMetadataRefreshThread" DefaultValue="false"/>
      <Parameter Name="Cns_Setting_RefreshIntervalInSecs" DefaultValue="15"/>
      <Parameter Name="Cns_Setting_DebugMode" DefaultValue="false"/>
      <Parameter Name="Cns_Setting_SnapshotIntervalInMins" DefaultValue="60"/>
    </Parameters>
  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="CnsWrapperService" ServiceManifestVersion="2021.1.22.1"/>
    <ConfigOverrides>
      <ConfigOverride Name="Config">
        <Settings>
          <Section Name="Config">
            <Parameter Name="WrapperShutdownThreadWaitTimeout" Value="[Cns_Setting_WrapperShutdownThreadWaitTimeout]" />
            <Parameter Name="WrapperMainThreadShutdownCheck" Value="[Cns_Setting_WrapperMainThreadShutdownCheck]" />
            <Parameter Name="WrapperMainLoopTimeout" Value="[Cns_Setting_WrapperMainLoopTimeout]" />
            <Parameter Name="WrapperThreadWaitTimeout" Value="[Cns_Setting_WrapperThreadWaitTimeout]" />
            <Parameter Name="EnablePortOverride" Value="[Cns_Setting_EnablePortOverride]" />
            <Parameter Name="StartCnm" Value="[Cns_Setting_StartCnm]" />
            <Parameter Name="SetupHnsAtStartup" Value="[Cns_Setting_SetupHnsAtStartup]" />
            <Parameter Name="DefaultExtNetworkType" Value="[Cns_Setting_DefaultExtNetworkType]" />
            <Parameter Name="EnableTelemetry" Value="[Cns_Setting_EnableTelemetry]" />
            <Parameter Name="HttpConnectionTimeoutInSeconds" Value="[Cns_Setting_HttpConnectionTimeoutInSeconds]" />
            <Parameter Name="HttpResponseHeaderTimeoutInSeconds" Value="[Cns_Setting_HttpResponseHeaderTimeoutInSeconds]" />
            <Parameter Name="StoreFilePath" Value="[Cns_Setting_StoreFilePath]" />
              <!-- keep in sync with config file https://github.com/Azure/azure-container-networking/blob/master/cns/configuration/cns_config.json -->
            <Parameter Name="DisableAll" Value="[Cns_Setting_DisableAll]"/>
            <Parameter Name="DisableTrace" Value="[Cns_Setting_DisableTrace]"/>
            <Parameter Name="DisableMetric" Value="[Cns_Setting_DisableMetric]"/>
            <Parameter Name="DisableEvent" Value="[Cns_Setting_DisableEvent]"/>
            <Parameter Name="TelemetryBatchSizeBytes" Value="[Cns_Setting_TelemetryBatchSizeBytes]"/>
            <Parameter Name="TelemetryBatchIntervalInSecs" Value="[Cns_Setting_TelemetryBatchIntervalInSecs]"/>
            <Parameter Name="HeartBeatIntervalInMins" Value="[Cns_Setting_HeartBeatIntervalInMins]"/>
            <Parameter Name="DisableMetadataRefreshThread" Value="[Cns_Setting_DisableMetadataRefreshThread]"/>
            <Parameter Name="RefreshIntervalInSecs" Value="[Cns_Setting_RefreshIntervalInSecs]"/>
            <Parameter Name="DebugMode" Value="[Cns_Setting_DebugMode]"/>
            <Parameter Name="SnapshotIntervalInMins" Value="[Cns_Setting_SnapshotIntervalInMins]"/>
          </Section>
        </Settings>
      </ConfigOverride>
    </ConfigOverrides>
    <ResourceOverrides>
      <Endpoints>
        <Endpoint Protocol="http" Name="AzureCnsEndpoint" Type="Input" Port="[Cns_Port]" />
      </Endpoints>
    </ResourceOverrides>
    <Policies>
      <RunAsPolicy CodePackageRef="Code" UserRef="SYSTEM" EntryPointType="All"/>
    </Policies>
  </ServiceManifestImport>
  <DefaultServices>
    <Service Name="CnsWrapperService">
      <StatelessService ServiceTypeName="CnsWrapperServiceType" InstanceCount="[Cns_InstanceCount]">
        <SingletonPartition />
      </StatelessService>
    </Service>
  </DefaultServices>
  <Principals>
    <Users>
      <User Name="SYSTEM" AccountType="LocalSystem"/>
    </Users>
  </Principals>
</ApplicationManifest>
