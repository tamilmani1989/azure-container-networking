<Project ToolsVersion="15.0" DefaultTarget="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(EnvironmentConfig)" />
  <Import Project="$(ExtendedTargetsPath)\NoTarget.targets" />
  <Target Name="Build">
    <Copy SourceFiles="$(DNC)\content\azure-dnc.exe" DestinationFolder="$(BinariesBuildTypeArchDirectory)\AzureDNCPackage" />   
    <Copy SourceFiles="$(DNC)\content\config.json" DestinationFolder="$(BinariesBuildTypeArchDirectory)\AzureDNCPackage" />    
  </Target>
</Project>