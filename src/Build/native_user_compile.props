<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"> 
  <Import Project="$(EnvironmentConfig)" />
  <Import Project="$(ExtendedTargetsPath)\Microsoft.Cpp.Default.props" />

  <!--Defaults-->
  <PropertyGroup>
    <WindowsTargetPlatformVersion>10.0.16299.0</WindowsTargetPlatformVersion>
    <CharacterSet>Unicode</CharacterSet>
    <TargetVersion>Windows8</TargetVersion>
  </PropertyGroup>

  <!-- Set retail vs debug properties with the correct CRT -->
  <Choose>
    <When Condition="'$(BuildType)' == 'retail'">
      <PropertyGroup>
        <CRuntimeLibrary>MultiThreadedDLL</CRuntimeLibrary>
        <UseDebugLibraries>false</UseDebugLibraries>
      </PropertyGroup>
    </When>
    <When Condition="'$(BuildType)' == 'debug'">
      <PropertyGroup>
        <CRuntimeLibrary>MultiThreadedDebugDLL</CRuntimeLibrary>
        <UseDebugLibraries>true</UseDebugLibraries>
      </PropertyGroup>
    </When>
  </Choose>

  <Import Project="$(ExtendedTargetsPath)\Microsoft.Cpp.props" />

  <ItemDefinitionGroup>
    <ClCompile>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebugDll</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDll</RuntimeLibrary>
      <MinimalRebuild>false</MinimalRebuild>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- disable warning related to redefinition in inner scope -->
      <DisableSpecificWarnings>%(DisableSpecificWarnings);4458;4456</DisableSpecificWarnings>
      <CompileAs>CompileAsCpp</CompileAs>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <WholeProgramOptimization>false</WholeProgramOptimization>
      <ExceptionHandling>sync</ExceptionHandling>
      <TreatWChar_tAsBuiltInType>true</TreatWChar_tAsBuiltInType>
      <UseFullPaths>true</UseFullPaths>
      <StructMemberAlignment>8Bytes</StructMemberAlignment>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
      <ProgramDatabaseFileName>$(OutDir)$(TargetName).pdb</ProgramDatabaseFileName>
      <ForceConformanceInForLoopScope>true</ForceConformanceInForLoopScope>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <StringPooling>true</StringPooling>
      <RuntimeLibrary>$(CRuntimeLibrary)</RuntimeLibrary>
      <PreprocessorDefinitions>
        %(PreprocessorDefinitions);
        CONDITION_HANDLING=1;
        WIN32_LEAN_AND_MEAN=1;
        _DISABLE_DEPRECATE_STATIC_CPPLIB;
        _SILENCE_STDEXT_HASH_DEPRECATION_WARNINGS;
        _USE_DECLSPECS_FOR_SAL=1;
        KTL_USER_MODE=1;
        KTL_MIXED_STL_ATL;
        JET_VERSION=0x0602;
        _APISET_MINCORE_VERSION=0x0102; 
        _APISET_MINWIN_VERSION=0x0103;
        _APISET_WINDOWS_VERSION=0x601;
      </PreprocessorDefinitions>
      <AdditionalIncludeDirectories>
        %(AdditionalIncludeDirectories);
        $(SrcRoot)\Common\Inc;
        $(PkgWindowsSdk_Corext)\Include\$(WindowsTargetPlatformVersion)\shared;
        $(PkgWindowsSdk_Corext)\Include\$(WindowsTargetPlatformVersion)\ucrt;
        $(PkgVisualCppTools)\lib\native\include;
        $(FC_Redist)\content\redist;
        $(TAEF_SDK)\build\include;
        $(SRCROOT)\Common\PrivateWindowsHeaders;
      </AdditionalIncludeDirectories>
      <!-- /Wv:18 use VC 2015 warnings for compat with rdcommon.h -->
      <AdditionalOptions>$(UseAwait) /Zm200 /Wv:18 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--Override for debug with retail runtime configuration-->
  <ItemDefinitionGroup Condition="'$(UseRetailCrtWithDebugBuild)' == 'true'">
    <ClCompile>
      <UndefinePreprocessorDefinitions>
        %(UndefinePreprocessorDefinitions);
        DBG;
        _DEBUG;
      </UndefinePreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
