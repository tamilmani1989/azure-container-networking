<Project ToolsVersion="15.0" DefaultTarget="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(EnvironmentConfig)" />
  <Import Project="$(ExtendedTargetsPath)\NoTarget.targets" />
  <Target Name="Build">
    <Copy SourceFiles="$(CNS)\content\windows\azure-cns.exe" DestinationFolder="$(BinariesBuildTypeArchDirectory)\AzureNetworkContainer" />
    <Copy SourceFiles="$(CNS)\content\windows\azure-vnet-telemetry.exe" DestinationFolder="$(BinariesBuildTypeArchDirectory)\AzureNetworkContainer" />
    <Copy SourceFiles="$(CNS)\content\windows\azure-vnet-telemetry.config" DestinationFolder="$(BinariesBuildTypeArchDirectory)\AzureNetworkContainer" />
    <Copy SourceFiles="$(CNS)\content\windows\cns_config.json" DestinationFolder="$(BinariesBuildTypeArchDirectory)\AzureNetworkContainer" />
  </Target>
</Project>