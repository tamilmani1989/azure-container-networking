<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(EnvironmentConfig)" />
  <Import Project="$(ExtendedTargetsPath)\NoTarget.targets" />
  <Import Project="$(PkgServiceSignTask)\content\FolderSigning.targets" />

  <ItemGroup>
    <ProjectReference Include="$(SrcRoot)\HostNetAgent\HostNetAgent.vcxproj"/>
  </ItemGroup>

  <PropertyGroup>
    <AppOutput>$(BinariesBuildTypeArchDirectory)\HostNetAgent</AppOutput>
    <ModernAPSigning>true</ModernAPSigning>
    <APServiceSigner>$(PkgServiceSignTask)\content</APServiceSigner>
    <IsValidateFilesEnabled>false</IsValidateFilesEnabled>
    <AvoidRename>true</AvoidRename>
    <FileNameCheckSpace>false</FileNameCheckSpace>

    <!-- If set to true, legacy cert (Autopilot Root CA) signing header will appear in build drop manifest file. -->
    <!-- If not set, default is true. -->
    <IsLegacyBuildDropManifestSigningEnabled>false</IsLegacyBuildDropManifestSigningEnabled>
    <!-- If set to true, Esrp signing header will appear in build drop manifest file. -->
    <!-- If not set, default is false. -->
    <IsEsrpBuildDropManifestSigningEnabled>true</IsEsrpBuildDropManifestSigningEnabled>
    <!-- App catalog signing should either be 'legacy' (using Autopilot Root CA cert) or 'esrp' (Microsoft Azure Catalog Code Sign). --> 
    <!-- If not set, default is 'legacy'. -->
    <AppCatalogSigning>esrp</AppCatalogSigning>
    <IsLocalSigningEnabled>true</IsLocalSigningEnabled>
    <TargetName>RobocopyFiles</TargetName>

    <BuildDependsOn>
      $(BuildDependsOn);
      CreateBuildShare;
      GeneratePackageForSigning;
      GeneratePathsForSigning;
      $(SignOutputDependsOn)
      MoveSignedEntityBackToParent;
    </BuildDependsOn>	
   </PropertyGroup>
   <Target Name="CreateBuildShare" AfterTargets="Build">
    <Message Text="CreateBuildShare started" Importance="high" />  
    <Exec Command="$(MsBuildThisFileDirectory)\CreateBuildShare.cmd $(AppOutput)" />
    <Message Text="CreateBuildShare finished" Importance="high" />
  </Target>

  <Target Name="GeneratePackageForSigning" AfterTargets="CreateBuildShare">
    <Message Text="GeneratePackageForSigning started" Importance="high" />   
    <Exec Command="$(MsBuildThisFileDirectory)\GeneratePackageForSigning.cmd $(AppOutput)" />
    <Message Text="GeneratePackageForSigning finished" Importance="high" />
  </Target>

  <!-- Set default value for signing-->
  <Target Name="GeneratePathsForSigning" Condition="'$(AppOutput)' != ''" >
    <ItemGroup Condition="'@(FoldersToSign)' == ''" >
      <FoldersToSign Include="$(AppOutput)" />
    </ItemGroup>
    <Message Text="FoldersToSign = @(FoldersToSign)" />
	
    <!-- in some cases (OutputPath), base on build env settings, can be missing creating explicitly -->
    <MakeDir Directories="$(OutputPath)"/>

    <Error Condition="!Exists('%(FoldersToSign.Identity)')" Text="Path %(FoldersToSign.Identity) not exists" />
    <Message Text="Done With signing" Importance="high" />
  </Target>

  <Target Name="MoveSignedEntityBackToParent" AfterTargets="GeneratePathsForSigning">
    <Message Text="MoveSignedEntityBackToParent started" Importance="high" />  
    <Exec Command="$(MsBuildThisFileDirectory)\MoveSignedEntityBackToParent.cmd $(BinariesBuildTypeArchDirectory) $(AppOutput) $(AppOutput)\HostNetAgent" />
    <Message Text="MoveSignedEntityBackToParent finished" Importance="high" />
  </Target>

</Project>