{
  "apiVersion": "vlabs",
  "properties": {
    "orchestratorProfile": {
      "orchestratorType": "Kubernetes",
      "orchestratorRelease": "1.14",
      "kubernetesConfig": {
        "apiServerConfig": {
          "--tls-min-version": "VersionTLS12",
          "--tls-cipher-suites": "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256"
        },
        "azureCNIURLLinux": "https://github.com/Azure/azure-container-networking/releases/download/v1.0.31/azure-vnet-cni-multitenancy-linux-amd64-v1.0.31.tgz",
        "azureCNIURLWindows": "https://github.com/Azure/azure-container-networking/releases/download/v1.0.31/azure-vnet-cni-multitenancy-windows-amd64-v1.0.31.zip",
        "addons": [
          {
            "name": "kubernetes-dashboard",
            "enabled" : false
          },
          {
            "name": "metrics-server",
            "enabled" : false
          },
          {
            "name": "tiller",
            "enabled" : false
          },
          {
            "name": "keyvault-flexvolume",
            "enabled" : false
          }
        ]
      }
    },
    "masterProfile": {
      "count": 1,
      "dnsPrefix": "eastus2euap-sr-rg",
      "vmSize": "Standard_DS2_v2"
    },
    "agentPoolProfiles": [
      {
        "name": "agentpool1",
        "count": 2,
        "vmSize": "Standard_DS2_v2",
        "availabilityProfile": "AvailabilitySet",
        "acceleratedNetworkingEnabled": false
      }
    ],
    "linuxProfile": {
      "adminUsername": "acn",
      "ssh": {
        "publicKeys": [
          {
            "keyData": ""
          }
        ]
      }
    },
    "servicePrincipalProfile": {
      "clientId": "aaf1de2b-61e2-4fba-91e6-94128dc7b095",
      "secret": ""
    }
  }
}
