<?xml version="1.0" encoding="utf-8"?>
<Runners>
  <RunnerDefinition RunnerName="NetworkPerformanceRunner" Description="NetworkPerformanceRunner (client) will query a runner (server) that sits on k8s cluster and periodically gets pod2pod and pod2vm performance results.">
    <!-- Any configuration Name/Value can be put into GlobalConfiguration, EnvironmentConfiguration or local configuration section. 
         LocalConfigurations gets higher precedance than EnvironmentConfiguration which gets higher precedence over GlobalConfiguration. -->
    <GlobalConfiguration>
      <Configuration Name="Component" Value="MyComponent" />
      <!-- Replace it with your component name. -->
      <Configuration Name="Description" Value="TBD" />
      <Configuration Name="MDMAccountName" Value="NetAgentHotPathProd" />
      <Configuration Name="Namespace" Value="NetworkPerformanceRunner" />
      <!-- This is the expected frequency which the runners run at, also corresponds to the life time of the health reports submitted by the runner. Default value is 10 if none is provided. -->
      <Configuration Name="ExpectedIntervalInMinutes" Value="20" />
      <Configuration Name="Owner" Value="acn@microsoft.com" />
    </GlobalConfiguration>
    <!-- On-Behalf Health Reporting setup 
      HealthAccountName: Your MDM Account.
      CertThumbprint: (Optional) Thumbprint of a certificate used to emit health reports. 
                      The certificate must be installed in the runner container.
      HealthEndpoint: (Optional) Specific health endpoint to emit the health reports to. 
                      If not provided then it will use the default for the Geneva Warm Path endpoint. -->
    <GlobalHealthDimension HealthAccountName="NetAgentHotPathProd" />
    <Environment EnvironmentName="Prod">
      <EnvironmentConfiguration>
        <!-- Override global configuration value of Owner for Environment Prod -->
        <Configuration Name="Owner" Value="acn@microsoft.com" />
      </EnvironmentConfiguration>
      <!-- We recommmend specifying runner location where you want to start this runner instance. To get deployable location by endpoint, please view: 
           https://jarvis.dc.ad.msft.net/?page=documents&section=f787c5ad-c22e-48aa-898a-1a042632f9d1&id=38973aa5-5931-4dd4-bae1-ef96f31ddf28
           If not specified whatever specified on command line will be applied to all the instances.
           Some sample command line parameters. You can pass any parameters you want.
          <CommandLineParameters>-queuelength:10 -accountname:myaccount1</CommandLineParameters> -->
      <RunnerInstance RunnerInstanceName="eastus2euapAccelRunner" Location="runnersvcprodbn3">
        <CommandExe>NetworkPerformanceRunner.exe</CommandExe>
        <CommandLineParameters>
        </CommandLineParameters>
        <LocalConfigurations>
          <Configuration Name="K8sEP" Value="runner-server-accelnet" />
          <Configuration Name="NetworkingType" Value="Accelerated" />
        </LocalConfigurations>
      </RunnerInstance>
      <RunnerInstance RunnerInstanceName="eastus2euapNotAccelRunner" Location="runnersvcprodbn3">
        <CommandExe>NetworkPerformanceRunner.exe</CommandExe>
        <CommandLineParameters>
        </CommandLineParameters>
        <LocalConfigurations>
          <Configuration Name="K8sEP" Value="runner-server-notaccelnet" />
          <Configuration Name="NetworkingType" Value="NotAccelerated" />
        </LocalConfigurations>
      </RunnerInstance>
    </Environment>
  </RunnerDefinition>
</Runners>