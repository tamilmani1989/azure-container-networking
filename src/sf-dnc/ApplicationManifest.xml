<?xml version="1.0" encoding="utf-8"?>
<ApplicationManifest xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ApplicationTypeName="DNCServiceApplicationType" ApplicationTypeVersion="1.0.1" xmlns="http://schemas.microsoft.com/2011/01/fabric" ManifestId="71bac519-696c-4fcb-9423-226eda994978">
  <Parameters>
    <Parameter Name="DNCService_InstanceCount" DefaultValue="1" />
    <Parameter Name="DNCService_DNSName" DefaultValue="sfdnc.app" />
  </Parameters>
  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="DNCServicePkg" ServiceManifestVersion="1.0.1" />
    <ConfigOverrides />
    <Policies>
      <RunAsPolicy CodePackageRef="Code" UserRef="DncSystem" EntryPointType="All"/>
    </Policies>
  </ServiceManifestImport>
  <DefaultServices>
    <Service Name="DNCService" ServiceDnsName="[DNCService_DNSName]" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="DNCServiceType" InstanceCount="[DNCService_InstanceCount]">
        <SingletonPartition/>
      </StatelessService>
    </Service>
  </DefaultServices>
  <Principals>
    <Users>
      <User Name="DncSystem" AccountType="LocalSystem"/>
    </Users>
  </Principals>
</ApplicationManifest>