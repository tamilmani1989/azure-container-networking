<?xml version="1.0" encoding="utf-8"?>
<ApplicationManifest xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ApplicationTypeName="DNCServiceApplicationType" ApplicationTypeVersion="1.0.2" xmlns="http://schemas.microsoft.com/2011/01/fabric" ManifestId="71bac519-696c-4fcb-9423-226eda994978">
  <Parameters>
    <Parameter Name="DNCService_InstanceCount" DefaultValue="3" />
    <Parameter Name="DNCService_DNSName" DefaultValue="sfdnc.app" />
    <Parameter Name="DNCBlobStorageName" DefaultValue=""/>
    <Parameter Name="DataStorePartitionKey" DefaultValue=""/>
    <Parameter Name="MasterElectionPartitionKey" DefaultValue=""/>
    <Parameter Name="DNCContainerName" DefaultValue=""/>
    <Parameter Name="DNCPort" DefaultValue="9001"/>
  </Parameters>
  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="DNCServicePkg" ServiceManifestVersion="1.0.2" />
    <ConfigOverrides />
    <ResourceOverrides />
    <EnvironmentOverrides CodePackageRef="Code">
      <EnvironmentVariable Name="DNCBlobName" Value="[DNCBlobStorageName]"/>
      <EnvironmentVariable Name="DNCContainerName" Value="[DNCContainerName]"/>
      <EnvironmentVariable Name="DNCPort" Value="[DNCPort]"/>
      <EnvironmentVariable Name="DataStorePartitionKey" Value="[DataStorePartitionKey]"/>
      <EnvironmentVariable Name="MasterElectionPartitionKey" Value="[MasterElectionPartitionKey]"/>
    </EnvironmentOverrides>
    <Policies>
      <RunAsPolicy CodePackageRef="Code" UserRef="DncSystem" EntryPointType="All"/>
    </Policies>
  </ServiceManifestImport>
  <DefaultServices>
    <Service Name="DNCService" ServiceDnsName="[DNCService_DNSName]" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="DNCServiceType" InstanceCount="[DNCService_InstanceCount]">
        <SingletonPartition/>
      </StatelessService>
    </Service>
  </DefaultServices>
  <Principals>
    <Users>
      <User Name="DncSystem" AccountType="LocalSystem"/>
    </Users>
  </Principals>
</ApplicationManifest>