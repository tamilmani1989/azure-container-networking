// Each service combination here represents a test case
// dnc - Test that host name will be localhost
// unittest1 - Test that host name will be Host IP
// utHostNameInEnvVar - Test that host name will come from envionment variable
{
  "Services": [
    {
      "ServiceName": "dnc",
      "Port": "9000",
      "Scheme": "http",
      "Host": "",
      "HostEnvironmentVariable": "DNCIpAddress"
    },
    {
      "ServiceName": "unittest1",
      "Port": "9001",
      "Scheme": "http",
      "Host": "50.12.122.142",
      "HostEnvironmentVariable": "DNCIpAddress"
    },
    {
      "ServiceName": "utHostNameInEnvVar",
      "Port": "9002",
      "Scheme": "http",
      "Host": "",
      "HostEnvironmentVariable": "ServiceIpAddress"
    }
  ]
}
