{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "IncludeScopes": true,
      "LogLevel": {
        "Default": "Trace"
      }
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.Azure.ContainerNetworking.DncRP.DncRPController": "Information",
        "Microsoft.Azure.ContainerNetworking.DncRP.Startup": "Information",
        "Microsoft.Azure.ContainerNetworking.DncRP.DelegateSubnetController": "Information",
        "Microsoft.Azure.ContainerNetworking.DncRP.DncController": "Information",
        "Microsoft.Azure.ContainerNetworking.DncRP.ControllerConfiguration": "Information",
        "Microsoft.Azure.ContainerNetworking.DncRP.TableOperations": "Information"
      }
    }
  },
  "KeyVault": {
    "Url": "https://acnkv.vault.azure.net",
    "SslCertName": "DncSslCert3"
  },
  "ApplicationInsights": {
    // iKey for testsub in acnAADTesting resource group
    "InstrumentationKey": "6f9518fc-9dc3-492e-87e2-b2b8941a0e92" // TODO: Populated in Release pipeline by _AppInsightsKey_
  },
  "Imds": {
    "InstanceEndpoint": "http://169.254.169.254/metadata/instance?api-version=2019-08-15&format=json"
  },
  "DataStoreSettings": [
    {
      "Region": "__Location__", // Populated in Release pipeline by _Location_
      "SubscriptionId": "__SubscriptionId__", // Populated in Release pipeline by _SubscriptionId_
      "ResourceGroup": "__DncRpResourceGroup__", // Populated in Release pipeline by _RPResourceGroup_
      "DBAccountName": "__DncRpCosmosDbAccountName__" // Populated in Release pipeline by _RPCosmosDbAccountName_
    }
  ],
  "ClientIdentities": [
    {
      "IdentityType": "ManagedIdentity", // this comes from ClientIdentityType enum in CoreLib
      "AppId": "__ClusterClientId__", // Populated in Release pipeline by  _ClusterClientId_
      "Tag": "ManagedIdentity" // this comes from ClientIdentityTags enum in CoreLib
    },
    {
      "IdentityType": "SpClientCertificate", // this comes from ClientIdentityType enum in CoreLib
      "AppId": "a91b1853-4403-4f54-b5cb-d1ea19d90c37",
      "TenantId": "",
      "KeyVaultCertPath": "__KeyVaultCertPath__", // Populated by Release pipeline (ex: https://acnkv.vault.azure.net/secrets/AMEAADOnecert/0516cc85edd74b36b8908ab95eaadd0c)
      "Tag": "AzureADArmToken" // this comes from ClientIdentityTags enum in CoreLib
    }
  ],
  "AllowedHosts": "*",
  "Port": "5002",
  "AzureEnvironment": "azurecloud", // Populated by _Environment- (ex: azurecloud)
  "AzureRegion": "__Location__" // Populated by __Location__
}