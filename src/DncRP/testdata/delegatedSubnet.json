{
    "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "controllerArmID": {
            "type": "string",
            "metadata": {
                "description": "controller ARM ID"
            }
        },
        "subnetArmID": {
            "type": "string",
            "metadata": {
                "description": "subnet ARM ID"
            }
        }
    },
    "resources": [
        {
            "type": "Microsoft.DelegatedNetwork/delegatedSubnets",
            "apiVersion": "2021-03-15",
            "name": "delegated-k8s-pod-subnet",
            "location": "East US 2 Euap",
            "properties": {
                "controllerDetails": {
                    "id": "[parameters('controllerArmID')]"
                },
                "subnetDetails": {
                    "id": "[parameters('subnetArmID')]"
                }
            }
        }
    ]
}