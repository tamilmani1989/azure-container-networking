<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$(EnvironmentConfig)" />
    <ItemGroup>
        <ProjectReference Include="AzureCNSPackage\AzureCNSPackage.nuproj" />
        <ProjectReference Include="AzureDNCPackage\AzureDNCPackage.nuproj" />
        <ProjectReference Include="NetworkClientLibrary\NetworkClientLibrary.nuproj" />
        <ProjectReference Include="NetAgentPackage\NetAgentPackage.nuproj" /> 
    </ItemGroup>
    <Import Project="$(MsBuildBinPath)\Microsoft.Common.Targets" />
    <PropertyGroup>
        <BuildDependsOn>ResolveReferences</BuildDependsOn>
    </PropertyGroup>
    <Target Name="VerifyAlteredTargetsUsed" />
  </Project>
