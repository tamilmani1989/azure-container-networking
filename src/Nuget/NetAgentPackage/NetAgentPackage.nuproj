<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" DefaultTargets="Build;CreatePackage" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(EnvironmentConfig)" />
  <PropertyGroup Label="Globals">
    <ProjectGuid>b9031a1c-7eb5-403c-9259-0276d19e126b</ProjectGuid>
  </PropertyGroup>
  <!-- Nuget generation properties -->
  <PropertyGroup>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <Id>Microsoft.WindowsAzure.Internal.$(GitBranchName)WindowsAzureNetAgent</Id>
    <Version>$(BuildVersion)</Version>
    <Title>WindowsAzureNetAgent Package</Title>
    <Authors>sdnagent@microsoft.com</Authors>
    <Owners>sdnagent@microsoft.com</Owners>
    <Description>Windows Azure VM Network Agent</Description>
    <ReleaseNotes>
    </ReleaseNotes>
    <Summary>This Package can be used to start and monitor plugins</Summary>
    <ProjectUrl>http://www.Microsoft.com</ProjectUrl>
    <LicenseUrl>http://www.Microsoft.com/license</LicenseUrl>
    <Copyright>Copyright (c) Microsoft Corporation</Copyright>
    <RequireLicenseAcceptance>False</RequireLicenseAcceptance>
    <Tags>
    </Tags>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="$(BinariesBuildTypeArchDirectory)\Artifacts">
        <TargetPath>content</TargetPath>
        <Recursive>true</Recursive>
    </Folder>
    <Content Include="$(BinariesBuildTypeArchDirectory)\Artifacts\NetAgent\Package\version.txt">
    </Content>
  </ItemGroup>
  <Import Project="$(PkgNuProj)\NuProj.Targets" />
</Project>