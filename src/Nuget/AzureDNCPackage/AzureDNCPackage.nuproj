<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" DefaultTargets="Build;CreatePackage" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(EnvironmentConfig)" />
  <PropertyGroup Label="Globals">
    <ProjectGuid>9705724C-1059-4A53-A363-D4847B3BD7F0</ProjectGuid>
     <RootNamespace>Aquarius</RootNamespace>
     <ConfigurationType>Application</ConfigurationType>
  </PropertyGroup>
  <!-- Nuget generation properties -->
  <PropertyGroup>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <Id>Microsoft.WindowsAzure.Internal.$(GitBranchName)AzureDNC</Id>
    <Version>$(BuildVersion)</Version>
    <Title>AzureDNC from $(GitBranchName)</Title>
    <Authors>connectdevs@microsoft.com</Authors>
    <Owners>connectdevs@microsoft.com</Owners>
    <Description>The delegated network controller service is highly available service that works in coordination with the orchestrator and will be responsible for the following.   

1. Management of delegated customer’s network address spaces. 

2. Management of network policies. 

3. Generate IP configuration goal states based on the request from orchestrators. 

4. Propagate the goal states to the agents running on the VM’s where the IP configurations needs to be instantiated. 

This service will expose restful API surface that will be used for bottoms up network provisioning. 

This service will also require persisting the configurations and the states that will require using a persisted data store and in the case of Antares this store will be hosted in Azure Storage. </Description>
    <ReleaseNotes>
    </ReleaseNotes>
    <Summary>
    </Summary>
    <ProjectUrl>http://www.Microsoft.com</ProjectUrl>
    <LicenseUrl>http://www.Microsoft.com/license</LicenseUrl>
    <Copyright>Copyright (c) Microsoft Corporation</Copyright>
    <RequireLicenseAcceptance>False</RequireLicenseAcceptance>  
    <Tags>
    </Tags>
  </PropertyGroup>
    <ItemGroup>
        <File Include="$(BinariesBuildTypeArchDirectory)\AzureDNCPackage\azure-dnc.exe">
            <TargetPath>content</TargetPath>
        </File>
        <File Include="$(BinariesBuildTypeArchDirectory)\AzureDNCPackage\config.json">
            <TargetPath>content</TargetPath>
        </File>
    </ItemGroup>
  <Import Project="$(PkgNuProj)\NuProj.Targets" />
</Project>