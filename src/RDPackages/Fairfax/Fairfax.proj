<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(EnvironmentConfig)" />
  <PropertyGroup>
      <BuildDependsOn>ResolveReferences</BuildDependsOn>
  </PropertyGroup>
  <PropertyGroup>
    <TargetDestination>RDPackage</TargetDestination>
    <ManifestOutputFile>manifest.FF.xml</ManifestOutputFile>
  </PropertyGroup>
  
  <Import Project="$(OneBranchBCDTPath)\OneBranch.BuildComposition.targets" />

  <Target
    Name="BuildGeneratedGroupItems"
    DependsOnTargets="$(BuildGeneratedGroupItemsDependsOn)">
    <ItemGroup>
       
       <CompositionItem1 Include="$(BinariesBuildTypeArchDirectory)\**\*.*"  Exclude="$(BinariesBuildTypeArchDirectory)\**\*.pdb;$(BinariesBuildTypeArchDirectory)\RDPackage\*.xml;$(BinariesBuildTypeArchDirectory)\**\*.ipdb" />
    </ItemGroup>
    <ItemGroup>
       <CompositionItems Include="%(CompositionItem1.Identity)">
          <CompositionOutputRelativeDir>$(BuildType)-$(BuildArchitecture)\%(CompositionItem1.RecursiveDir)</CompositionOutputRelativeDir>
       </CompositionItems>
    </ItemGroup>
  </Target>
</Project>
