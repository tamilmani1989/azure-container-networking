{
  "DataStoreSettings": {
    "SubscriptionId": "__SubscriptionId__",
    "ResourceGroup": "__ResourceGroup__",
    "DBAccountName": "__RpCosmosDbAccountName__"
  },
  "AzureSettings": {
    "AzureEnvironment": "azurecloud"
  },
  "ClientIdentities": [
    {
      "IdentityType": "ManagedIdentity", // this comes from ClientIdentityType enum in CoreLib
