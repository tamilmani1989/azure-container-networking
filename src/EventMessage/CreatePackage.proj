<Project ToolsVersion="15.0" DefaultTarget="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$(EnvironmentConfig)" />
    <Import Project="$(ExtendedTargetsPath)\NoTarget.targets" />
    
    <PropertyGroup>
      <BuildFullName>$(BuildVersion.Replace('.',''))</BuildFullName>
      <McPath>$(PkgWindowsSdk_Corext)\bin\10.0.16299.0\x64\mc.exe</McPath>
      <ToolsPath>$(PkgVisualCppTools)\lib\native\bin\amd64</ToolsPath>
      <LinkPath>$(ToolsPath)\link.exe</LinkPath>
      <RcPath>$(PkgWindowsSdk_Corext)\bin\10.0.16299.0\x64\rc.exe</RcPath>
      <CpPath>$(Corext_Tools)\AMD64\cp.exe</CpPath>
    </PropertyGroup>
    
  <ItemGroup>
    <ProjectReference Include="..\AquariusLibrary\AquariusLibrary.vcxproj">
      <Project>{8264c27c-90a7-4d86-a714-a9759d9afaf4}</Project>
    </ProjectReference>
  </ItemGroup>

  <Target Name="Build">
     <Message Importance="high" Text="Going to build event message dll for eventviewer to work." />
     <Exec Command="$(McPath) -U AqEventMessage.mc &amp; $(RcPath) AqEventMessage.rc &amp; $(LinkPath) -dll -noentry /MACHINE:x86 AqEventMessage.res"/>
     <Exec Command="md $(BinariesBuildTypeArchDirectory)\AqEventMessage\ &amp; cp AqEventMessage.dll $(BinariesBuildTypeArchDirectory)\AqEventMessage\AqEventMessage.dll" />
     <Exec Command="md $(BinariesBuildTypeArchDirectory)\test\AquariusTest\ &amp; cp AqEventMessage.dll $(BinariesBuildTypeArchDirectory)\test\AquariusTest\AqEventMessage.dll" />
  </Target>

  <ItemGroup>
    <QCustomInput Include="AqEventMessage.mc" />
    <QCustomOutput Include="AqEventMessage.rc" />
  </ItemGroup>
</Project>