<Project ToolsVersion="4.0" DefaultTarget="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$(EnvironmentConfig)" />
    <Import Project="$(ExtendedTargetsPath)\NoTarget.targets" />
    
    <PropertyGroup>
      <BuildFullName>$(BuildVersion.Replace('.',''))</BuildFullName>
      <McPath>$(PkgWindowsSdk_Corext)\bin\x64\mc.exe</McPath>
      <ToolsPath>$(PkgVisualCpp_Tools_x64_Corext)\bin\x64</ToolsPath>
      <LinkPath>$(ToolsPath)\link.exe</LinkPath>
      <RcPath>$(PkgWindowsSdk_Corext)\bin\x64\rc.exe</RcPath>
      <CpPath>$(Corext_Tools)\AMD64\cp.exe</CpPath>
    </PropertyGroup>
    
  <ItemGroup>
    <ProjectReference Include="..\Aquarius\Aquarius.vcxproj">
      <Project>{9423C797-BDDE-4411-8AEA-6396F4A97F3B}</Project>
    </ProjectReference>
  </ItemGroup>

  <Target Name="Build">
     <Message Importance="high" Text="Going to build event message dll for eventviewer to work." />
     <Exec Command="$(McPath) -U AqEventMessage.mc &amp; $(RcPath) AqEventMessage.rc &amp; $(LinkPath) -dll -noentry /MACHINE:x86 AqEventMessage.res"/>
     <Exec Command="md $(BinariesBuildTypeArchDirectory)\AquariusPackage &amp; md $(BinariesBuildTypeArchDirectory)\AquariusPackage\Plugins &amp; $(CpPath) AqEventMessage.dll $(BinariesBuildTypeArchDirectory)\AquariusPackage &amp; xcopy /s $(NetAnalytics)\content $(BinariesBuildTypeArchDirectory)\AquariusPackage\Plugins"/>
  </Target>

  <ItemGroup>
    <QCustomInput Include="AqEventMessage.mc" />
    <QCustomOutput Include="AqEventMessage.rc" />
  </ItemGroup>
</Project>