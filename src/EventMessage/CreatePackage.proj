<Project ToolsVersion="4.0" DefaultTarget="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$(EnvironmentConfig)" />
    <Import Project="$(ExtendedTargetsPath)\NoTarget.targets" />
    
    <PropertyGroup>
      <BuildFullName>$(BuildVersion.Replace('.',''))</BuildFullName>
    </PropertyGroup>
    
  <ItemGroup>
    <ProjectReference Include="..\Aquarius\Aquarius.vcxproj">
      <Project>{9423C797-BDDE-4411-8AEA-6396F4A97F3B}</Project>
    </ProjectReference>
  </ItemGroup>

  <Target Name="Build">
     <Message Importance="high" Text="Going to build event message dll for eventviewer to work." />
     <Exec Command="mc -U AqEventMessage.mc &amp; rc AqEventMessage.rc &amp; link -dll -noentry /MACHINE:x86 AqEventMessage.res"/>
     <Exec Command="md $(BinariesBuildTypeArchDirectory)\AquariusPackage &amp; md $(BinariesBuildTypeArchDirectory)\AquariusPackage\Plugins &amp; cp AqEventMessage.dll $(BinariesBuildTypeArchDirectory)\AquariusPackage &amp; xcopy /s $(NetAnalytics)\content $(BinariesBuildTypeArchDirectory)\AquariusPackage\Plugins"/>
  </Target>
</Project>