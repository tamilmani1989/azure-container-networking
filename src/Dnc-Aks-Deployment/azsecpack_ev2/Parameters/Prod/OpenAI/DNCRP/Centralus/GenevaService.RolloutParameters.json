{
  "$schema": "https://ev2schema.azure.net/schemas/2020-01-01/rolloutParameters.json",
  "contentVersion": "1.0.0.0",
  "applications": [      	
    {
      "serviceResourceName": "myAksService2",
      "applicationName": "myApp1",
      "authentication": {
        "type": "CertificateAuthentication",
        "properties": {
            "AksRole": "User"
        }
      },
      "applicationSecrets": {
        "replacements": {  
          "__gcscert__": {
            "secretId": "__GenevaPubKey__",
            "convertToBase64": "true"
          },
          "__gcskey__": {
            "secretId": "__GenevaPrivateKey__",
            "convertToBase64": "true"
          }
        }
      }
    }
  ]
}