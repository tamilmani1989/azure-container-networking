<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(EnvironmentConfig)" />
  <PropertyGroup>
    <CoverageDisabled>true</CoverageDisabled>
    <RunCodeAnalysis>$(RunCA)</RunCodeAnalysis>
  </PropertyGroup>
  <!--Required before anything else.-->
  <PropertyGroup>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
  </PropertyGroup>
  <!--Standard settings required for building in Razzle - do not remove.-->
  <!--Project-specific settings required for building in services\fc - do not remove.-->
  <!--IDE specific-->
  <PropertyGroup>
    <ProductVersion>9.0.30729</ProductVersion>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{5E535016-0AFC-4B3F-9652-944C1E02B320}</ProjectGuid>
  </PropertyGroup>
  <!--Project specific-->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Microsoft.WindowsAzure.Networking.Aquarius.CNIReportTests</RootNamespace>
    <AssemblyName>CNIReportTests</AssemblyName>
    <NUnitTest>true</NUnitTest>
    <NUnitUserFlags>/domain:None</NUnitUserFlags>
	<OutDirSuffix>test\$(AssemblyName)\</OutDirSuffix>
    <!--<NUnitTestCov>true</NUnitTestCov>-->
    <!--<DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>-->
  </PropertyGroup>
  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>
  <!--Assembly references-->
  <ItemGroup>
    <Reference Include="$(PkgMicrosoft_WindowsAzure_EngSys_Internal_rnm_mstest_Engineering_Redist)\content\Microsoft.VisualStudio.QualityTools.UnitTestFramework.dll">
      <Name>Microsoft.VisualStudio.QualityTools.UnitTestFramework</Name>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(JsonNetwonSoft)\lib\net45\Newtonsoft.Json.dll">
      <Name>NetwonsoftJson</Name>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(PkgMicrosoft_WindowsAzure_EngSys_Internal_rd_taef_taef_x64)\content\x64\TestExecution\TE.Managed.dll">
      <Name>TE.Managed</Name>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.IdentityModel" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <!--Files-->
  <ItemGroup>
    <Compile Include=" CNIReportUnitTestCases.cs" />
  </ItemGroup>
  <Import Project="$(ExtendedTargetsPath)\Microsoft.CSharp.targets" />
  <Target Name="AfterBuild">
    <ItemGroup>
      <Robocopy Include="$(PkgMicrosoft_WindowsAzure_EngSys_Internal_rd_taef_taef_x64)\content\x64\TestExecution\*">
        <DestinationFolder>$(BinariesBuildTypeArchDirectory)\test\CNIReportTests</DestinationFolder>
        <FileMatch>*pdb *dll *exe *config</FileMatch>
        <Recursive>true</Recursive>
      </Robocopy>
      <Robocopy Include="$(PkgMicrosoft_WindowsAzure_EngSys_Internal_rnm_mstest_Engineering_Redist)\content\*">
        <DestinationFolder>$(BinariesBuildTypeArchDirectory)\test\CNIReportTests</DestinationFolder>
        <FileMatch>*pdb *dll *exe *config</FileMatch>
        <Recursive>true</Recursive>
      </Robocopy>
      <Robocopy Include="$(JsonNetwonSoft)\lib\net45\*">
        <DestinationFolder>$(BinariesBuildTypeArchDirectory)\test\CNIReportTests</DestinationFolder>
        <FileMatch>*pdb *dll *exe *config</FileMatch>
        <Recursive>true</Recursive>
      </Robocopy>
      <Robocopy Include="$(SRCROOT)\test\CNIReportTests\TestDependencies\*">
        <DestinationFolder>$(BinariesBuildTypeArchDirectory)\test\CNIReportTests\Documents</DestinationFolder>
        <Recursive>true</Recursive>
      </Robocopy>
      <Robocopy Include="$(SRCROOT)\test\HostNetAgentTests\TestDependencies\NetAgentHostPlugin.PluginSpecific.xml">
        <DestinationFolder>$(BinariesBuildTypeArchDirectory)\test\CNIReportTests</DestinationFolder>
      </Robocopy>
      <Robocopy Include="$(SRCROOT)\..\.config\.tools\wttlog.dll">
        <DestinationFolder>$(BinariesBuildTypeArchDirectory)\test\CNIReportTests</DestinationFolder>
      </Robocopy>
    </ItemGroup>
  </Target>
</Project>