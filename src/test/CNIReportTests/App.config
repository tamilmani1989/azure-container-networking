<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="cfx.runtimeSettings" type="System.Configuration.AppSettingsSection" />
    <section name="fabricSettings" type="System.Configuration.AppSettingsSection" />
  </configSections>
  <appSettings>
    <add key="RnmSpecificLogFile" value="RnmTraces"/>
    <add key="RnmMode" value="Desktop"/>
    <add key="InstanceName" value="DesktopRoleInstance"/>
    <add key="DcmCertificateThumbprint" value="067c46c5b0665901d1222a371777ec3962db0de7" />
  </appSettings>
  <cfx.runtimeSettings>
    <add key="MiniDumpPath" value="MiniDumps"/>
    <add key="LogPath" value="RuntimeLogs"/>
    <add key="TraceSourceName" value="CfxTraces"/>
    <add key="AutoFlushFrequencyInMilliseconds" value="1000" />
  </cfx.runtimeSettings>
  <fabricSettings>
    <!--default settings are used for this unit test assembly-->
  </fabricSettings>
</configuration>
