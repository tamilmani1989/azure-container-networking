<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(EnvironmentConfig)" />
  <ItemGroup>
    <ProjectReference Include="NetworkClientTest\NetworkClientTest.vcxproj" />
    <ProjectReference Include="ServiceTunnelExtensionTest\ServiceTunnelExtensionTest.vcxproj" />
    <ProjectReference Include="AquariusTest\AquariusTest.vcxproj" />
    <ProjectReference Include="TestSetup\TestSetup.proj" />
    <ProjectReference Include="HostNetAgentTests\HostNetAgentTests.csproj" />
    <ProjectReference Include="CNIReportTests\CNIReportTests.csproj" />
    <ProjectReference Include="NetworkContainerTest\NetworkContainerTest.vcxproj" />
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.Common.targets" />
  <PropertyGroup>
    <BuildDependsOn>ResolveReferences</BuildDependsOn>
  </PropertyGroup>
  <Target Name="VerifyAlteredTargetsUsed" />
  <Target Name="CleanupEmptyRefsFolder" />
</Project>