<?xml version="1.0" encoding="UTF-8"?>
<TestJobGroup EnableProcessJobObjectBreakaway="true">
   <ResourceSpec>
      <Resource SKU="Standard_D4s_v3" Image="2016-Datacenter" />
      <tenantId>azurenetworkingaquarius</tenantId>
   </ResourceSpec>
   <Setup>
      <!-- All references to the build should be made from <BuildFiles> and <Services> sections. 
         All references to the data  should be made from <DataFiles> section. 
         Other sections should reference files in the working directory . -->
      <BuildFiles>
         <!--The ordering of Copy elements does not matter. In case of any overlaps, cloudtest only overwrites copy over symlink.-->
         <Copy Src="[BuildRoot]\retail-amd64\*" Dest="[WorkingDirectory]\" IsRecursive="true" Writable="true" />
      </BuildFiles>
      <Scripts />
   </Setup>
   <TestJob Name="NetworkClientTest" Type="SingleBox" Tags="Suite=Suite0" OwnerAliases="tamanoha">
      <Execution Type="TAEF" Path="[WorkingDirectory]\test\NetworkClientTest\NetworkClientTest.dll" Args="" />
   </TestJob>
   <TestJob Name="AquariusTest" Type="SingleBox" Tags="Suite=Suite0" OwnerAliases="tamanoha">
