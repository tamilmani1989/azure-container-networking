        $(WindowsSdk64LibPath)\ws2_32.lib;
	  </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="NetworkClientTest.cpp" />
  </ItemGroup>
    <ItemGroup>
    <ClInclude Include="stdafx.h" />
  </ItemGroup>
   <ItemGroup>
    <ProjectReference Include="$(SRCROOT)\NetworkClientLibrary\NetworkClientLibrary.vcxproj" />
   </ItemGroup>
     <ItemGroup>
    <Robocopy Include="$(BinariesBuildTypeArchDirectory)\NetworkClientLibrary\NetworkClientLibrary.dll">
