<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(EnvironmentConfig)" />
  <Import Project="RDPackages\PostBuild.targets" Condition="'$(IsOfficialBuild)'!='' Or '$(BuildRDPackage)'=='true' Or '$(PostbuildProject)'!=''" /> 
  <ItemGroup>
    <ProjectFile Include="Aquarius\Aquarius.vcxproj" />
    <ProjectFile Include="Common\bond\dirs.proj" />
    <ProjectFile Include="EventMessage\CreatePackage.proj" />
    <ProjectFile Include="ServiceTunnelExtension\ServiceTunnelExtension.vcxproj" />
    <ProjectFile Include="VFPlugin\VFPlugin.vcxproj" />
    <ProjectFile Include="NetworkClientLibrary\NetworkClientLibrary.vcxproj" />
    <ProjectFile Include="NetworkClient\NetworkClient.vcxproj" />
    <ProjectFile Include="Logging\Logging.vcxproj" />
    <ProjectFile Include="HNSOverlayPlugin\HNSOverlayPlugin.vcxproj" />
    <ProjectFile Include="HNSClient\HNSClient.vcxproj" />
    <ProjectFile Include="Server\Server.vcxproj" />
    <ProjectFile Include="RestClient\RestClient.vcxproj" />
    <ProjectFile Include="aquanix\aquanix.vcxproj" />
    <ProjectFile Include="aquanixconsole\aquanixconsole.vcxproj" />
    <ProjectFile Include="test\dirs.proj" />
    <ProjectFile Include="GAExtension\AquariusGaExt.vcxproj" />
    <ProjectFile Include="HostNetAgent\HostNetAgent.vcxproj" />
    <ProjectFile Include="Common\NetAgentContracts\NetAgentContracts.vcxproj" />
    <ProjectFile Include="NetworkContainer\NetworkContainer.vcxproj" />
    <ProjectFile Include="AzureCNSPackage\AzureCNSPackage.proj" />
    <ProjectFile Include="AzureDNCPackage\AzureDNCPackage.proj" />
    <ProjectFile Include="Ifx\IfxEvents.vcxproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectFile Include="CodeSign\CodesignSettings.proj" Condition="'$(IsOfficialBuild)' != ''">
      <BuildInParallel>false</BuildInParallel>
    </ProjectFile>
    <ProjectFile Include="CodeSignMisc\CodesignSettings.proj" Condition="'$(IsOfficialBuild)' != ''">
      <BuildInParallel>false</BuildInParallel>
    </ProjectFile>
    <ProjectFile Include="NetAgentPackage\NetAgentPackage.proj" Condition="'$(QBUILD)'!='1'">
      <BuildInParallel>false</BuildInParallel>
    </ProjectFile>
    <ProjectFile Include="AquariusPackage\AquariusPackage.proj" Condition="'$(QBUILD)'!='1'">
      <BuildInParallel>false</BuildInParallel>
    </ProjectFile>    
    <ProjectFile Include="HostPluginPackage\NetAgentIndependentDeployment.proj" Condition="'$(QBUILD)'!='1'">
      <BuildInParallel>false</BuildInParallel>
    </ProjectFile>
    <ProjectFile Include="Nuget\dirs.proj" Condition="'$(IsOfficialBuild)' != ''">
      <BuildInParallel>false</BuildInParallel>
    </ProjectFile> 
  </ItemGroup>
    
  <Import Project="$(ExtendedTargetsPath)\Traversal.targets" />
</Project>
