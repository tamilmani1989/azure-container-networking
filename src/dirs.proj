<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(EnvironmentConfig)" />
  <ItemGroup>
    <ProjectReference Include="Aquarius\Aquarius.vcxproj" />
    <ProjectReference Include="EventMessage\CreatePackage.proj" />
    <ProjectReference Include="Common\XmlParseHelper\XmlParserHelper.vcxproj" />
    <ProjectReference Include="LoopbackAdapterInstaller\LoopbackAdapterInstaller.vcxproj" />
    <ProjectReference Include="ServiceTunnelExtension\ServiceTunnelExtension.vcxproj" />
    <ProjectReference Include="NetworkClientLibrary\NetworkClientLibrary.vcxproj" />
    <ProjectReference Include="NetworkClient\NetworkClient.vcxproj" />
    <ProjectReference Include="Nuget\dirs.proj" Condition="'$(IsOfficialBuild)'!='' Or '$(BuildRDPackage)'=='true' Or '$(BuildNugetPackage)'=='true'" />
    <ProjectReference Include="SignLocalFiles\SignLocalFiles.proj" Condition="'$(IsOfficialBuild)' != ''" />
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.Common.targets" />
  <PropertyGroup>
    <BuildDependsOn>ResolveReferences</BuildDependsOn>
  </PropertyGroup>
  <Target Name="VerifyAlteredTargetsUsed" />
</Project>
