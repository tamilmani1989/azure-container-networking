<Project ToolsVersion="14.0" DefaultTarget="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(EnvironmentConfig)" />
  <Import Project="$(ExtendedTargetsPath)\NoTarget.targets" />
  <PropertyGroup>
    <BuildFullName>$(BuildVersion.Replace('.',''))</BuildFullName>
    <McPath>$(PkgWindowsSdk_Corext)\bin\x64\mc.exe</McPath>
    <ToolsPath>$(PkgVisualCpp_Tools_x64_Corext)\bin\x64</ToolsPath>
    <LinkPath>$(ToolsPath)\link.exe</LinkPath>
    <RcPath>$(PkgWindowsSdk_Corext)\bin\x64\rc.exe</RcPath>
    <CpPath>$(PkgCorext_Tools)\AMD64\cp.exe</CpPath>
  </PropertyGroup>

  <Target Name="GatherFiles" AfterTargets="PostBuildCopyToFiles">
    <PropertyGroup>
      <AquariusPackage>$(BinariesBuildTypeArchDirectory)\AquariusPackage</AquariusPackage>
      <Aquarius>Aquarius</Aquarius>
    </PropertyGroup>

    <Message Importance="high" Text="Going to generate $(Aquarius) Package" />

    <Copy SourceFiles="$(SRCROOT)\GAExtension\AzureExtensionPackage\VMExtension\disable.cmd" DestinationFolder="$(AquariusPackage)" />
    <Copy SourceFiles="$(SRCROOT)\GAExtension\AzureExtensionPackage\VMExtension\enable.cmd" DestinationFolder="$(AquariusPackage)" />
	  <Copy SourceFiles="$(SRCROOT)\GAExtension\AzureExtensionPackage\VMExtension\install.cmd" DestinationFolder="$(AquariusPackage)" />
	  <Copy SourceFiles="$(SRCROOT)\GAExtension\AzureExtensionPackage\VMExtension\uninstall.cmd" DestinationFolder="$(AquariusPackage)" />
    <Copy SourceFiles="$(SRCROOT)\GAExtension\AzureExtensionPackage\VMExtension\update.cmd" DestinationFolder="$(AquariusPackage)" />
    <Copy SourceFiles="$(SRCROOT)\GAExtension\AzureExtensionPackage\VMExtension\HandlerManifest.json" DestinationFolder="$(AquariusPackage)" />

    <Copy SourceFiles="$(BinariesBuildTypeArchDirectory)\Aquarius\Aquarius.exe" DestinationFolder="$(AquariusPackage)\$(Aquarius)" />
    <Copy SourceFiles="$(BinariesBuildTypeArchDirectory)\AqEventMessage\AqEventMessage.dll" DestinationFolder= "$(AquariusPackage)\$(Aquarius)" />
    <Copy SourceFiles="$(BinariesBuildTypeArchDirectory)\Aqua.Logging\Aqua.Logging.dll" DestinationFolder="$(AquariusPackage)\$(Aquarius)" />
    <Copy SourceFiles="$(BinariesBuildTypeArchDirectory)\Aqua.RestServer\Aqua.RestServer.dll" DestinationFolder="$(AquariusPackage)\$(Aquarius)" />
    <Copy SourceFiles="$(VCRuntime)\lib\msvcp140.dll; $(VCRuntime)\lib\vcruntime140.dll; $(VCRuntime)\lib\concrt140.dll" DestinationFolder="$(AquariusPackage)\$(Aquarius)" />
    <Copy SourceFiles="$(cpprestsdk)\lib\native\v140\windesktop\msvcstl\dyn\rt-dyn\x64\Release\cpprest140_2_9.dll" DestinationFolder="$(AquariusPackage)\$(Aquarius)" />
    <Copy SourceFiles="$(BinariesBuildTypeArchDirectory)\Aqua.RestClient\Aqua.RestClient.exe" DestinationFolder="$(AquariusPackage)\$(Aquarius)" />

    <Copy SourceFiles="$(BinariesBuildTypeArchDirectory)\ServiceTunnelExtension\ServiceTunnelExtension.exe" DestinationFolder="$(AquariusPackage)\$(Aquarius)\Plugins\ServiceTunnelExtension\Code" />
	  <Copy SourceFiles="$(VCRuntime)\lib\msvcp140.dll; $(VCRuntime)\lib\vcruntime140.dll; $(VCRuntime)\lib\concrt140.dll" DestinationFolder="$(AquariusPackage)\$(Aquarius)\Plugins\ServiceTunnelExtension\Code" />
    <Copy SourceFiles="$(SRCROOT)\ServiceTunnelExtension\manifest.xml;$(SRCROOT)\ServiceTunnelExtension\config.xml" DestinationFolder="$(AquariusPackage)\$(Aquarius)\Plugins\ServiceTunnelExtension" />
    <Copy SourceFiles="$(BinariesBuildTypeArchDirectory)\Aqua.Logging\Aqua.Logging.dll" DestinationFolder="$(AquariusPackage)\$(Aquarius)\Plugins\ServiceTunnelExtension\Code" />

    <Copy SourceFiles="$(SRCROOT)\GAExtension\AzureExtensionPackage\GAExtensionImage-Aquarius.xml" DestinationFolder="$(BinariesBuildTypeArchDirectory)\AquariusDeployScripts"/>
    <Copy SourceFiles="$(SRCROOT)\GAExtension\AzureExtensionPackage\UploadExtensionImage.ps1" DestinationFolder="$(BinariesBuildTypeArchDirectory)\AquariusDeployScripts"/>

  </Target>

  <ItemGroup>
    <QCustomInput Include="AqEventMessage.mc" />
    <QCustomOutput Include="AqEventMessage.rc" />
  </ItemGroup>
</Project>