<!--
***********************************************************************************************
Environment.props

This file overrides shipped msbuild settings to work well in an isolated no-install drop

Environment.Custom.props should be configured by the build environment administrators to
  * Setup paths to local SDKs and Tools
  * Add the necessary extensibility hooks for customization from consumers

Build environment administrators must call Environment.{cmd|ps1} from this directory to
setup the build environment properly.


Copyright (C) Microsoft Corporation. All rights reserved.
***********************************************************************************************
-->

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>    
    <AssemblyCompany>Microsoft CoreXT</AssemblyCompany>  
    <AssemblyDescription>Microsoft CoreXT</AssemblyDescription>
  </PropertyGroup>
  
  <!-- Auto generate NuGet packages from projects. This is temporary stopgap solution 
    to help with migrations until we can get a permanant packaging system in place. -->
  <PropertyGroup>    
    <InstallPkgLocal Condition="'$(InstallPkgLocal)'==''">false</InstallPkgLocal>
  </PropertyGroup>

  <!-- use x64 toolset -->
  <PropertyGroup>
     <PreferredToolArchitecture>x64</PreferredToolArchitecture>
     <_IsNativeEnvironment>true</_IsNativeEnvironment>
     <_VcUseNativex64CompilerTools>true</_VcUseNativex64CompilerTools>
     <VCToolArchitecture>Native64Bit</VCToolArchitecture>
  </PropertyGroup>
  
  <PropertyGroup>
    <!--Target windows 8 for most things -->
    <TargetVersion>Windows8</TargetVersion>
    <!--Drvier packaging breaks CloudBuild and unecessarily calls MSBuild from packaging targets-->
    <SupportsPackaging>false</SupportsPackaging>
    <!--We will have verifier errors since we don't use catalogue files in our .inf configuration files-->
    <SkipPackageVerification>true</SkipPackageVerification>
    <!--Disable test signing everywhere-->
    <SignMode>Off</SignMode>
    <!--Set .NET to 4.5 everywhere-->
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
  </PropertyGroup>

  <PropertyGroup>
      <!--Due to CoreXT compatability issues in VS these need to get set-->
    <BaseBuildType Condition="'$(BuildType)'=='debug'">debug</BaseBuildType>
    <BaseBuildType Condition="'$(BuildType)'=='retail'">retail</BaseBuildType>
  </PropertyGroup>

  <!--C++ compiler settings-->
  <ItemDefinitionGroup>
    <ClCompile>
      <MinimalRebuild>true</MinimalRebuild>
      <MultiProcessorCompilation>false</MultiProcessorCompilation>
    </ClCompile>
  </ItemDefinitionGroup>
  
  <!-- Turning off CLS compliance warnings/errors -->
  <PropertyGroup>    
    <AssemblyCLSCompliant>false</AssemblyCLSCompliant> 
  </PropertyGroup>
  
  <!-- Required for using Nuproj targets since we don't check in NuGet.exe -->
  <PropertyGroup>
    <NuProjToolPath>$(PkgNuGet_CommandLine)\tools</NuProjToolPath>
  </PropertyGroup> 

  <!-- Add in StyleCop -->
  <PropertyGroup>
    <StyleCopEnabled>true</StyleCopEnabled>
    <StyleCopVersion Condition="'$(StyleCopVersion)' == ''">4.3.0.8</StyleCopVersion>
  </PropertyGroup>

  <PropertyGroup Label="Globals">
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  </PropertyGroup>
  
  <PropertyGroup>
    <RobocopyRetryCount>3</RobocopyRetryCount>
    <RobocopyRetryWait>200</RobocopyRetryWait>
    <RobocopyShowErrorOnRetry>false</RobocopyShowErrorOnRetry>
  </PropertyGroup>

  <!-- Drop the .covsym files in the desired location -->
  <PropertyGroup>
    <CoverageCovsymPath>$(BinariesBuildTypeArchDirectory)\covsym</CoverageCovsymPath>
  </PropertyGroup>

  
  <ItemGroup>
    <!-- Global header files -->
    <QCustomInput Include="$(SRCROOT)\shared\*.h" >
      <Visible>false</Visible>
    </QCustomInput>
  </ItemGroup>
</Project>
