<!--
***********************************************************************************************
    Repository Configuration 

    Initial settings and repository wide configuration for entry points and common data
    Used to defined everything from name to publishing packages per each repository
    
    Copyright (C) Microsoft Corporation. All rights reserved.
***********************************************************************************************
-->

<Repository>
  <!-- Common settings -->
  <Name>Networking-Aquarius</Name>
  <Description>The VM Network Agent.</Description>
  <!-- Path is sometimes used by build drop -->
  <Path>Toolsets</Path>
  <Owners>susharm</Owners>

  <!-- Precheckin validation -->
  <CodeReviewEmailTo>susharm</CodeReviewEmailTo>
  <DevPackagePublishServer>\\wanuget\NugetPackages\Dev</DevPackagePublishServer>

  <!-- Official build configuration | email aliases must contain @microsoft.com | separate multiple emails by comma -->
  <BuildEmailTo>susharm@microsoft.com;nsrivast@microsoft.com</BuildEmailTo>
  <OfficialPackagePublishServer>\\wanuget\NugetPackages\Official</OfficialPackagePublishServer>

  <!-- Auto export packages in this section to the package store -->
  <ExportPackages>
    <Package>Basic.ClassLibrary</Package>
    <Package>WcfServiceApp</Package>
  </ExportPackages>

  <!-- Name of the CloudBuild Queue for branch -->
  <Q>
    <QueueName>Networking_Aquarius</QueueName>
  </Q>

  <!-- Official/Buddy defaultBuildSystem options: Jenkins, BuildTracker -->
  <OfficialBuild>
    <DefaultParameters>
      <OACR_LEG_NAME>retail amd64</OACR_LEG_NAME>
    </DefaultParameters>
  </OfficialBuild>
  <BuddyBuild defaultBuildSystem="BuildTracker" />
  
  <!-- Separate multiple emails by semicolon -->
  <CodeReview>
    <RequiredReviewers>susharm</RequiredReviewers>
    <OptionalReviewers>nsrivast</OptionalReviewers>
  </CodeReview>

  <!-- Trust Services Automation (TSA) for SDL log processing -->
    <TSA>
    <DefaultBranches>Aquarius</DefaultBranches>
    <Notification>susharm@microsoft.com</Notification>
    <AreaPath>One\Networking\Aquarius</AreaPath> 
    <!-- Uncomment this line if you are using MSAzure for work item tracking 
    <Template>TFSMSAzure</Template>
    -->
    <!-- Requirement is to run Credscan only for now -->
    <!-- If you wish to onboard to all SDL tool, please remove the following line -->
    <ToolsOptOut>BinScope;APIScan;PoliCheck;FxCop</ToolsOptOut>
  </TSA>
</Repository>
